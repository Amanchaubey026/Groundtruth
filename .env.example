# Server
PORT=4000
CLIENT_URL=http://localhost:5173
DB_PATH=./data/inbox.db

# Default generator is Ollama phi3:mini. Switch models in the UI header.
# The app does not auto-pull Ollama weights. If the model is missing, the UI
# shows a toast: install Ollama, then `ollama pull phi3:mini`.
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=phi3:mini

# Optional. If set, OpenRouter appears in the model dropdown.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional hosted LLM (SpaceXAI / xAI). Used when LLM_PROVIDER=xai.
# XAI_API_KEY=
# XAI_MODEL=grok-4.6

# Retrieval
TOP_K=4
MIN_SIMILARITY=0.30

# URL fetching
URL_FETCH_TIMEOUT_MS=10000
MAX_URL_RESPONSE_BYTES=5000000

# Frontend (optional; client defaults to http://localhost:4000)
# VITE_API_URL=http://localhost:4000
