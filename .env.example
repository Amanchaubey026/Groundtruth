# Server
PORT=4000
CLIENT_URL=http://localhost:5173
DB_PATH=./data/inbox.db

# Local LLM (default)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# LLM provider: "ollama" (default) or "xai"
LLM_PROVIDER=ollama

# Optional hosted LLM (SpaceXAI / xAI). Used when LLM_PROVIDER=xai.
# XAI_API_KEY=
# XAI_MODEL=grok-4.6

# Retrieval
TOP_K=4
MIN_SIMILARITY=0.30

# URL fetching
URL_FETCH_TIMEOUT_MS=10000
MAX_URL_RESPONSE_BYTES=5000000

# Frontend (optional; client defaults to http://localhost:4000)
# VITE_API_URL=http://localhost:4000
