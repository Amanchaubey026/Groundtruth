# Server
PORT=4000
CLIENT_URL=http://localhost:5173
DB_PATH=./data/inbox.db

# LLM provider: "openrouter" (default), "ollama" (local models only), or "xai"
LLM_PROVIDER=openrouter

# Default hosted LLM (OpenRouter). openai/gpt-oss-20b:free needs no credits.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local Ollama (optional). The app does not pull models for you.
# 1. Install Ollama and make sure `ollama list` works (run `ollama serve` if not).
# 2. Pull first: `ollama pull llama3.1:8b`  (or `ollama pull phi3:mini` on low RAM)
# 3. Set LLM_PROVIDER=ollama and OLLAMA_MODEL to that exact name.
# 4. Restart the server. Do not use Cloud tags such as gpt-oss:20b-cloud.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Optional hosted LLM (SpaceXAI / xAI). Used when LLM_PROVIDER=xai.
# XAI_API_KEY=
# XAI_MODEL=grok-4.6

# Retrieval
TOP_K=4
MIN_SIMILARITY=0.30

# URL fetching
URL_FETCH_TIMEOUT_MS=10000
MAX_URL_RESPONSE_BYTES=5000000

# Frontend (optional; client defaults to http://localhost:4000)
# VITE_API_URL=http://localhost:4000
